# ============================================
# Kraftworks Career Hub — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# Frontend vars (VITE_*) are used at build time.
# Backend vars are set as Cloudflare Workers secrets.

# ══════════════════════════════════════════════
#  SANDBOX MODE (Quick Start — no API keys needed)
# ══════════════════════════════════════════════
# Set both of these to "true" to run the entire app
# without any real API keys. AI responses will be mocked,
# emails will be logged to console, and auth is bypassed
# with a mock admin user.
#
# Frontend: skips Clerk, uses mock user
VITE_SANDBOX_MODE=true
# Backend: set in wrangler.toml [vars] or via wrangler secret
# SANDBOX_MODE=true  (already uncommentable in wrangler.toml)

# ── Frontend (Vite) ──────────────────────────
# Clerk publishable key (starts with pk_test_ or pk_live_)
# Not required when VITE_SANDBOX_MODE=true
VITE_CLERK_PUBLISHABLE_KEY=

# API base URL — your deployed Workers URL (no trailing slash)
# Local dev: http://localhost:8787
VITE_API_BASE_URL=http://localhost:8787

# Employer portal URL (separate Vercel deployment)
# Set this to the employer portal's production URL
VITE_EMPLOYER_URL=https://hiring.kraftworks.app

# Main app URL (used by employer portal for cross-links back to career fair)
# Only needed on the employer Vercel project
VITE_MAIN_APP_URL=https://career.kraftworks.app

# ── Backend (Cloudflare Workers Secrets) ─────
# Set these via: wrangler secret put <KEY_NAME>
# None of these are required when SANDBOX_MODE=true

# Clerk secret key (starts with sk_test_ or sk_live_)
CLERK_SECRET_KEY=

# Clerk webhook signing secret (whsec_...)
# Used to verify Clerk webhook payloads at /api/webhooks/clerk
CLERK_WEBHOOK_SECRET=

# Google Gemini API key — powers AI resume feedback & interview questions (free tier)
# Get yours at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Resend API key — sends transactional emails
RESEND_API_KEY=

# Admin email address — receives resume review notifications & contact form alerts
ADMIN_EMAIL=
